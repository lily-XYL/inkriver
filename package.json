{
  "name": "inkriver",
  "productName": "InkRiver",
  "version": "1.1.1",
  "description": "墨河 InkRiver —— 面向长篇小说的 Windows 写作应用",
  "main": "./out/main/index.js",
  "author": "InkRiver",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/setup-wincodesign.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win dir && node scripts/finalize-dir.cjs",
    "dist:dir": "electron-vite build && electron-builder --win dir",
    "smoke": "electron-vite build && electron . --smoke-test"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^2.10.0",
    "@tiptap/extension-character-count": "^2.10.0",
    "@tiptap/extension-highlight": "^2.10.0",
    "@tiptap/extension-image": "^2.10.0",
    "@tiptap/extension-link": "^2.10.0",
    "@tiptap/extension-placeholder": "^2.10.0",
    "@tiptap/extension-table": "^2.10.0",
    "@tiptap/extension-table-cell": "^2.10.0",
    "@tiptap/extension-table-header": "^2.10.0",
    "@tiptap/extension-table-row": "^2.10.0",
    "@tiptap/extension-task-item": "^2.10.0",
    "@tiptap/extension-task-list": "^2.10.0",
    "@tiptap/extension-text-align": "^2.10.0",
    "@tiptap/extension-underline": "^2.10.0",
    "@tiptap/pm": "^2.10.0",
    "@tiptap/react": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.4.1",
    "docx": "^9.1.1",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "turndown": "^7.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "zustand": "^5.0.3"
  },
    "build": {
      "appId": "com.inkriver.app",
      "productName": "InkRiver",
      "copyright": "Copyright © 2026 InkRiver",
      "afterPack": "scripts/after-pack.cjs",
      "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
      "win": {
        "icon": "build/icon.ico",
        "signAndEditExecutable": false,
        "target": [
          {
            "target": "dir",
            "arch": [
              "x64"
            ]
          }
        ],
        "artifactName": "InkRiver-${version}-portable.${ext}"
    }
  }
}
